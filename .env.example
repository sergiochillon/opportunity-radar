# ==========================================
# OPPORTUNITY RADAR: Configuración de Entorno
# ==========================================
# Copia este archivo a .env y completa tus valores reales.
# NUNCA compartas ni subas tu archivo .env a Git.

# --- MODO DE EJECUCIÓN ---
ENVIRONMENT=development  # development | production
LOG_LEVEL=INFO

# --- TELEGRAM BOT NOTIFICATIONS ---
# Obtén tu bot token en @BotFather y tu chat_id en @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- GOOGLE GEMINI API (LLM) ---
# Clave gratuita de Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- REDDIT OAUTH2 API (TIER 1 COLLECTOR) ---
# Crea una app 'script' en https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=OpportunityRadar/1.0 (by /u/YOUR_REDDIT_USERNAME)
REDDIT_USERNAME=
REDDIT_PASSWORD=

# --- GITHUB SEARCH API (OPCIONAL / TIER 2) ---
# Personal Access Token clásico sin scopes para elevar rate limit a 30 req/min
GITHUB_PAT=

# --- BASE DE DATOS Y PERSISTENCIA ---
DATABASE_PATH=data/radar.db
PROFILE_PATH=config/profile.yaml

# --- SCHEDULER ---
POLL_INTERVAL_MINUTES=15
